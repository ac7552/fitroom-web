# Copy to .env.local and fill in what you use. Without any of these, `npm run dev` answers /api itself with
# the small Node API (apps/api): no Rails needed.

# The Rails app to use for /api in development instead (store links and the AI try-on need it): its bin/dev.
# FITROOM_API_PROXY=http://localhost:3000

# Where the built page finds the API, when it isn't on the page's own address (no trailing slash). The Rails
# app must then allow this page's address: FITROOM_WEB_ORIGINS there.
# VITE_API_URL=https://api.fitroom.example

# Where the built page finds the 3D models, when they're on a CDN rather than the page's own /models.
# VITE_MODELS_URL=https://cdn.fitroom.example/models
