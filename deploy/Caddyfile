# The page and the API on one address: the built page (apps/web/dist) as files, /api to the Rails app.
# Replace fitroom.example with your domain; Caddy gets its certificate.
fitroom.example {
	encode zstd gzip

	handle /api/* {
		reverse_proxy localhost:3000
	}

	# The 3D models and the built scripts don't change under the same name: keep them a long time.
	@lasting path /assets/* /models/*
	header @lasting Cache-Control "public, max-age=31536000, immutable"

	handle {
		root * /srv/fitroom-web/dist
		file_server
	}
}
